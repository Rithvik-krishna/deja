# Copy to .env (never commit .env)
MODE=mock                 # mock = in-memory reference engine (works with zero setup) | live = Neo4j
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Freeze the clock for rehearsals so "recent deploy" windows are stable (the v2.3.1 deploy is 2026-10-14):
# DEJA_FIXED_NOW=2026-10-17T07:00:00Z
VITE_API_URL=http://localhost:8000

 "components": {
  "schemas": {
   "AlertRequest": {
    "properties": {
     "service": {
      "type": "string",
      "title": "Service",
      "description": "Service where the symptom is observed"
     },
     "symptom": {
      "type": "string",
      "enum": [
       "latency",
       "timeout",
       "5xx",
       "oom"
      ],
      "title": "Symptom"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Title"
     },
     "severity": {
      "type": "string",
      "enum": [
       "SEV1",
       "SEV2",
       "SEV3"
      ],
      "title": "Severity",
      "default": "SEV2"
     }
    },
    "type": "object",
    "required": [
     "service",
     "symptom"
    ],
    "title": "AlertRequest"
   },
   "AlertResponse": {
    "properties": {
     "incident": {
      "$ref": "#/components/schemas/IncidentSummary"
     },
     "likely_origin": {
      "type": "string",
      "title": "Likely Origin"
     },
     "suspects": {
      "items": {
       "$ref": "#/components/schemas/Suspect"
      },
      "type": "array",
      "title": "Suspects"
     },
     "similar_incidents": {
      "items": {
       "$ref": "#/components/schemas/SimilarIncident"
      },
      "type": "array",
      "title": "Similar Incidents"
     },
     "recommendations": {
      "items": {
       "$ref": "#/components/schemas/Recommendation"
      },
      "type": "array",
      "title": "Recommendations"
     },
     "graph": {
      "$ref": "#/components/schemas/GraphPayload"
     }
    },
    "type": "object",
    "required": [
     "incident",
     "likely_origin",
     "suspects",
     "similar_incidents",
     "recommendations",
     "graph"
    ],
    "title": "AlertResponse"
   },
   "AttemptSummary": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "fix": {
      "type": "string",
      "title": "Fix"
     },
     "status": {
      "type": "string",
      "enum": [
       "SUCCESS",
       "FAILED"
      ],
      "title": "Status"
     },
     "ts": {
      "type": "string",
      "title": "Ts"
     },
     "engineer": {
      "type": "string",
      "title": "Engineer"
     },
     "notes": {
      "type": "string",
      "title": "Notes",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "id",
     "fix",
     "status",
     "ts",
     "engineer"
    ],
    "title": "AttemptSummary"
   },
   "BlastItem": {
    "properties": {
     "service": {
      "type": "string",
      "title": "Service"
     },
     "tier": {
      "type": "string",
      "title": "Tier"
     },
     "hops": {
      "type": "integer",
      "title": "Hops"
     },
     "owner": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Owner"
     }
    },
    "type": "object",
    "required": [
     "service",
     "tier",
     "hops"
    ],
    "title": "BlastItem"
   },
   "BlastResponse": {
    "properties": {
     "service": {
      "type": "string",
      "title": "Service"
     },
     "depth": {
      "type": "integer",
      "title": "Depth"
     },
     "total": {
      "type": "integer",
      "title": "Total"
     },
     "impacted": {
      "items": {
       "$ref": "#/components/schemas/BlastItem"
      },
      "type": "array",
      "title": "Impacted"
     },
     "recent_deploys": {
      "items": {
       "$ref": "#/components/schemas/DeploySummary"
      },
      "type": "array",
      "title": "Recent Deploys"
     },
     "graph": {
      "$ref": "#/components/schemas/GraphPayload"
     }
    },
    "type": "object",
    "required": [
     "service",
     "depth",
     "total",
     "impacted",
     "recent_deploys",
     "graph"
    ],
    "title": "BlastResponse"
   },
   "Catalog": {
    "properties": {
     "services": {
      "items": {
       "$ref": "#/components/schemas/CatalogService"
      },
      "type": "array",
      "title": "Services"
     },
     "fixes": {
      "items": {
       "$ref": "#/components/schemas/CatalogFix"
      },
      "type": "array",
      "title": "Fixes"
     },
     "engineers": {
